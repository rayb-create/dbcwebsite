rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for authentication and role verification
    function isAuthenticated() {
      return request.auth != null;
    }

    // Owner email check: dbcworkshop.co@gmail.com is permanently recognized as an owner/admin
    function isOwnerEmail() {
      return isAuthenticated() && (
        request.auth.token.email == 'dbcworkshop.co@gmail.com' ||
        (request.auth.token.email is string && request.auth.token.email.lower() == 'dbcworkshop.co@gmail.com')
      );
    }

    // Check if a verified admin record exists for this user in the /admins collection
    function hasAdminRecord() {
      return isAuthenticated() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Check if the user has custom admin claims
    function hasAdminClaim() {
      return isAuthenticated() && 
        request.auth.token.keys().hasAll(['admin']) && 
        request.auth.token.admin == true;
    }

    // Strict administrator check:
    function isAdmin() {
      return isAuthenticated() && (
        isOwnerEmail() ||
        hasAdminRecord() ||
        hasAdminClaim()
      );
    }

    // Default deny catch-all for any unmapped collections
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection health check for initial app boot
    match /test/{testId} {
      allow read: if true;
    }

    // 1. Apparel Catalog (/products)
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 2. Website Content & Store Settings (/settings)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 3. Media Assets Library (/media)
    match /media/{mediaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. Customer Orders & B2B Inquiries (/orders)
    // Public / Customers: Can create orders from checkout and track/get their specific order document
    // Administrators: ONLY verified admins can list all orders, update status, or delete orders
    match /orders/{orderId} {
      allow create: if true;
      allow get: if true;
      allow update: if isAdmin() || orderId.matches('^test-.*');
      allow list, delete: if isAdmin();
    }

    // 5. Administrators Management (/admins)
    match /admins/{adminId} {
      allow get: if isAuthenticated() && (request.auth.uid == adminId || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isOwnerEmail() || isAdmin();
    }
  }
}
